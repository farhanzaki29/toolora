---
/**
 * Word Counter workspace. Markup + styles only; behaviour lives in src/scripts/wordCounter.js
 * and the counting rules in src/lib/wordCount.js.
 */
import { READING_WPM, SPEAKING_WPM } from '../../lib/wordCount.js';

const primary = { key: 'words', label: 'Words' };
const counts = [
  { key: 'characters', label: 'Characters' },
  { key: 'charactersNoSpaces', label: 'Characters without spaces' },
  { key: 'sentences', label: 'Sentences' },
  { key: 'paragraphs', label: 'Paragraphs' },
];
const times = [
  { key: 'readingTime', label: 'Reading time' },
  { key: 'speakingTime', label: 'Speaking time' },
];
---

<div class="wc" data-wc data-empty>
  <section class="editor" aria-labelledby="wc-label">
    <div class="editor-head">
      <label id="wc-label" for="wc-text">Your text</label>
      <span class="privacy">Counted in your browser. Your text is not uploaded or saved.</span>
    </div>

    <textarea
      id="wc-text"
      name="text"
      rows="12"
      placeholder="Start typing or paste your text here..."
      autocomplete="off"
      autocapitalize="sentences"
      spellcheck="true"
      data-wc-input></textarea>

    <div class="toolbar">
      <div class="controls">
        <div class="actions" data-wc-actions>
          <button class="btn btn-primary btn-sm" type="button" data-wc-copy disabled>Copy Text</button>
          <button class="btn btn-secondary btn-sm" type="button" data-wc-clear disabled>Clear</button>
        </div>
        <div class="confirm" role="group" aria-label="Confirm clearing the text" data-wc-confirm hidden>
          <span>Clear all text?</span>
          <button class="btn btn-primary btn-sm danger" type="button" data-wc-confirm-yes>Yes, clear</button>
          <button class="btn btn-secondary btn-sm" type="button" data-wc-confirm-no>Keep text</button>
        </div>
        <p class="status" role="status" aria-live="polite" data-wc-status></p>
      </div>
      <p class="mini" aria-hidden="true" data-wc-mini>0 words · 0 characters</p>
    </div>
  </section>

  <section class="stats" aria-labelledby="wc-stats-title">
    <h2 id="wc-stats-title" class="stats-title">Statistics</h2>

    <dl class="hero-stat">
      <dt>{primary.label}</dt>
      <dd data-stat={primary.key}>0</dd>
    </dl>

    <dl class="grid">
      {counts.map((c) => (
        <div class="stat">
          <dt>{c.label}</dt>
          <dd data-stat={c.key}>0</dd>
          {c.key === 'characters' && (
            <p
              class="sub"
              data-wc-codepoints
              hidden
              title="The count above uses the standard JavaScript length, where emoji and some rare characters take two units. A Unicode code point counts each of them once."
            >
              <span data-wc-codepoints-n>0</span> Unicode code points
            </p>
          )}
        </div>
      ))}
    </dl>

    <dl class="grid times">
      {times.map((t) => (
        <div class="stat">
          <dt>{t.label}</dt>
          <dd class="time" data-stat={t.key}>—</dd>
        </div>
      ))}
    </dl>

    <p class="note">
      Reading and speaking times are estimates, based on {READING_WPM} and {SPEAKING_WPM} words per minute. Real speeds vary.
      Sentence counts are approximate: a single line break does not end a sentence, and unusual abbreviations may be miscounted.
    </p>
  </section>
</div>

<script>
  import '../../scripts/wordCounter.js';
</script>

<style>
  .wc { display: grid; gap: 1.25rem; align-items: start; }
  @media (min-width: 1000px) {
    .wc { grid-template-columns: minmax(0, 1fr) 21rem; gap: 1.5rem; }
    .stats { position: sticky; top: calc(var(--header-h) + 1rem); }
  }

  .editor, .stats {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  /* ---- Editor ---- */
  .editor { padding: clamp(1rem, 2.5vw, 1.5rem); }
  .editor-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.75rem;
  }
  .editor-head label { font-family: var(--font-display); font-size: 1.1875rem; font-weight: 600; color: var(--ink); }
  .privacy { font-size: 0.8125rem; color: var(--muted); }

  textarea {
    display: block;
    width: 100%;
    min-height: clamp(16rem, 52vh, 32rem);
    padding: 1rem 1.1rem;
    background: var(--surface-inset);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: 1.0625rem; /* 17px: also avoids iOS zoom-on-focus */
    line-height: 1.7;
    color: var(--ink);
    resize: vertical;
    transition: border-color var(--fast) var(--ease), box-shadow var(--fast) var(--ease);
  }
  textarea::placeholder { color: var(--placeholder); }
  textarea:focus, textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-tint);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: 0.9rem;
  }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.9rem; min-width: 0; }
  .actions, .confirm { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .actions[hidden], .confirm[hidden] { display: none; }
  .confirm span { font-size: 0.9375rem; font-weight: 600; color: var(--ink); margin-right: 0.25rem; }
  @media (max-width: 479px) {
    /* Label on its own row so both buttons always sit side by side */
    .confirm span { flex-basis: 100%; margin-right: 0; }
  }
  .danger { background: var(--clay-text); }
  .danger:hover { background: var(--clay-text); filter: brightness(0.92); }
  :global(:root[data-theme='dark']) .danger { background: var(--clay); color: var(--accent-ink); }
  @media (max-width: 639px), (pointer: coarse) {
    .toolbar :global(.btn) { height: 44px; padding-inline: 1.1rem; }
  }
  .mini { font-size: 0.875rem; color: var(--muted); font-variant-numeric: tabular-nums; }

  .status { font-size: 0.875rem; font-weight: 600; min-height: 1.3em; }
  .status[data-kind='ok'] { color: var(--success); }
  .status[data-kind='bad'] { color: var(--clay-text); }
  .status[data-kind='ok']::before { content: '\2713\00a0'; }

  /* ---- Statistics ---- */
  .stats { padding: clamp(1rem, 2.5vw, 1.5rem); display: grid; gap: 1rem; }
  .stats-title {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay-text);
  }
  dl, dd, dt { margin: 0; }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 1.1rem;
    background: var(--surface-inset);
    border: 1px solid var(--line);
    border-left: 3px solid var(--clay);
    border-radius: var(--radius);
  }
  .hero-stat dt { font-size: 0.875rem; font-weight: 600; color: var(--ink-2); }
  .hero-stat dd {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 3.75rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .stat dt { font-size: 0.8125rem; line-height: 1.3; color: var(--muted); }
  .stat dd {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .stat dd.time { font-family: var(--font-sans); font-size: 1rem; font-weight: 600; line-height: 1.35; padding-top: 0.2rem; }
  [data-empty] .time { color: var(--placeholder); }
  .sub { margin: 0.1rem 0 0; font-size: 0.75rem; line-height: 1.35; color: var(--muted); font-variant-numeric: tabular-nums; cursor: help; }
  .sub[hidden] { display: none; }

  .note { font-size: 0.8125rem; line-height: 1.5; color: var(--muted); }

  @media (min-width: 640px) and (max-width: 999px) {
    /* Tablet: statistics sit in a wider band under the editor */
    .stats { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr); column-gap: 1rem; align-items: start; }
    .stats-title, .note { grid-column: 1 / -1; }
    .hero-stat { grid-row: 2 / span 2; height: 100%; justify-content: center; }
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .grid.times { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
