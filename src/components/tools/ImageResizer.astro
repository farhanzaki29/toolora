---
/**
 * Image Resizer workspace. Markup + styles only; behaviour lives in src/scripts/imageResizer.js,
 * the dimension rules in src/lib/imageResizer.js and the browser encoding in src/lib/imageResizeCodec.js.
 */
import { MAX_FILE_BYTES, MAX_PIXELS } from '../../lib/imageCompressor.js';
import { MAX_DIMENSION, PERCENT_PRESETS, SIZE_PRESETS, RESIZE_QUALITY } from '../../lib/imageResizer.js';

const formats = [
  { value: 'original', label: 'Same as original' },
  { value: 'image/jpeg', label: 'JPEG' },
  { value: 'image/png', label: 'PNG' },
  { value: 'image/webp', label: 'WebP' },
];
const modes = [
  { value: 'custom', label: 'Custom size' },
  { value: 'percent', label: 'Percentage' },
  { value: 'preset', label: 'Common sizes' },
];
const pretty = (n) => n.toLocaleString('en-US');
---

<div class="ir" data-ir>
  <!-- ============ Upload ============ -->
  <section class="card drop" data-ir-drop aria-labelledby="ir-drop-title">
    <input id="ir-file" class="sr-only" type="file" multiple accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" tabindex="-1" aria-label="Choose images to resize" data-ir-input />
    <div class="drop-body">
      <h2 id="ir-drop-title" class="drop-title">Add your images</h2>
      <p class="drop-lead">Drag and drop JPG, PNG or WebP images here, or choose them from your device. You can resize several at once with the same settings.</p>
      <button class="btn btn-primary" type="button" data-ir-browse>Browse files</button>
      <p class="drop-hint">
        Up to {MAX_FILE_BYTES / 1048576} MB and {MAX_PIXELS / 1e6} megapixels per image, and up to 100 images at a time. Your images stay on your device: they are resized in your browser and are never uploaded.
      </p>
    </div>
  </section>
  <p class="notes" role="status" aria-live="polite" data-ir-notes hidden></p>

  <div class="layout">
    <!-- ============ Settings ============ -->
    <section class="card settings" aria-labelledby="ir-set-title">
      <h2 id="ir-set-title" class="card-title">Resize settings</h2>

      <fieldset class="group">
        <legend>How do you want to resize?</legend>
        <div class="segmented three" role="radiogroup">
          {modes.map((m) => (
            <label class="seg"><input type="radio" name="ir-mode" value={m.value} checked={m.value === 'custom'} /><span>{m.label}</span></label>
          ))}
        </div>
      </fieldset>

      <!-- Custom -->
      <div class="group panel" data-ir-panel-custom>
        <div class="dims">
          <div class="field">
            <label for="ir-width">Width (px)</label>
            <input id="ir-width" class="input" type="text" inputmode="numeric" autocomplete="off" placeholder="automatic" aria-describedby="ir-lock-note ir-width-msg" data-ir-width />
            <p class="msg" id="ir-width-msg" aria-live="polite" data-ir-width-msg hidden></p>
          </div>
          <span class="times" aria-hidden="true">&times;</span>
          <div class="field">
            <label for="ir-height">Height (px)</label>
            <input id="ir-height" class="input" type="text" inputmode="numeric" autocomplete="off" placeholder="automatic" aria-describedby="ir-lock-note ir-height-msg" data-ir-height />
            <p class="msg" id="ir-height-msg" aria-live="polite" data-ir-height-msg hidden></p>
          </div>
        </div>
        <label class="check">
          <input type="checkbox" checked data-ir-lock />
          <span>Keep proportions (lock aspect ratio)</span>
        </label>
        <p class="help" id="ir-lock-note" data-ir-lock-note></p>
        <p class="help">Each side can be up to {pretty(MAX_DIMENSION)} px. Resizing never crops the picture.</p>
      </div>

      <!-- Percentage -->
      <div class="group panel" data-ir-panel-percent hidden>
        <fieldset class="group">
          <legend>Scale to</legend>
          <div class="segmented wrap" role="radiogroup">
            {PERCENT_PRESETS.map((p) => (
              <label class="seg"><input type="radio" name="ir-percent" value={String(p)} checked={p === 50} /><span>{p}%</span></label>
            ))}
          </div>
        </fieldset>
        <div class="field">
          <label for="ir-percent-custom">Or enter a custom percentage</label>
          <div class="pct-row">
            <input id="ir-percent-custom" class="input narrow" type="text" inputmode="decimal" autocomplete="off" placeholder="e.g. 62.5" aria-describedby="ir-percent-msg" data-ir-percent-custom />
            <span class="unit" aria-hidden="true">%</span>
          </div>
          <p class="msg" id="ir-percent-msg" aria-live="polite" data-ir-percent-msg hidden></p>
        </div>
        <p class="help">100% keeps the size. Values above 100% enlarge the picture, which can make it look soft because no new detail is added.</p>
      </div>

      <!-- Common sizes -->
      <div class="group panel" data-ir-panel-preset hidden>
        <fieldset class="group">
          <legend>Fit inside</legend>
          <div class="presets" role="radiogroup">
            {SIZE_PRESETS.map((p) => (
              <label class="preset">
                <input type="radio" name="ir-size" value={p.id} checked={p.id === '1920x1080'} />
                <span class="preset-body"><strong>{p.width} &times; {p.height}</strong><small>{p.note}</small></span>
              </label>
            ))}
          </div>
        </fieldset>
        <label class="check">
          <input type="checkbox" checked data-ir-keep-small />
          <span>Don’t enlarge images that are already smaller</span>
        </label>
        <p class="help">Each image is made as large as it can be while fitting inside the box, keeping its proportions. Nothing is cropped or stretched, so one side may be smaller than the box. These are common sizes, not a guarantee of what any website or app requires.</p>
      </div>

      <fieldset class="group">
        <legend>Save as</legend>
        <div class="segmented wrap" role="radiogroup">
          {formats.map((f) => (
            <label class="seg"><input type="radio" name="ir-format" value={f.value} checked={f.value === 'original'} /><span>{f.label}</span></label>
          ))}
        </div>
        <p class="help" data-ir-format-note></p>
        <p class="help">PNG is lossless. JPEG and WebP are saved at high quality ({RESIZE_QUALITY}).</p>
      </fieldset>

      <div class="group bg" data-ir-bg-field hidden>
        <label for="ir-bg">Background for transparent areas</label>
        <div class="bg-row">
          <input id="ir-bg" class="color" type="color" value="#ffffff" data-ir-bg />
          <output class="bg-out" for="ir-bg" data-ir-bg-out>#FFFFFF</output>
        </div>
        <p class="help">JPEG cannot store transparency, so transparent areas are filled with this colour. White is the default.</p>
      </div>

      <p class="help fine">Resized files do not include photo details such as camera model or location (EXIF). Your original files are never changed.</p>
    </section>

    <!-- ============ Results ============ -->
    <section class="card results" aria-labelledby="ir-res-title">
      <div class="res-head">
        <h2 id="ir-res-title" class="card-title">Your images <span class="count" data-ir-count></span></h2>
        <div class="toolbar-actions" data-ir-toolbar-actions>
          <button class="btn btn-primary btn-sm" type="button" data-ir-run-all disabled>Resize</button>
          <button class="btn btn-secondary btn-sm" type="button" data-ir-cancel hidden>Stop</button>
          <button class="btn btn-secondary btn-sm" type="button" data-ir-download-all hidden>Download</button>
          <button class="btn btn-secondary btn-sm" type="button" data-ir-clear-all disabled>Clear all</button>
        </div>
        <div class="confirm" role="group" aria-label="Confirm clearing all images" data-ir-confirm hidden>
          <span>Remove all images and results?</span>
          <button class="btn btn-primary btn-sm danger" type="button" data-ir-confirm-yes>Yes, clear all</button>
          <button class="btn btn-secondary btn-sm" type="button" data-ir-confirm-no>Keep</button>
        </div>
      </div>

      <div class="progress" data-ir-progress hidden>
        <div class="bar" role="progressbar" aria-label="Resizing progress" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" data-ir-bar><span class="bar-fill" data-ir-bar-fill></span></div>
        <p class="progress-text" data-ir-progress-text></p>
      </div>
      <p class="summary" data-ir-summary hidden></p>
      <p class="toast" role="status" aria-live="polite" data-ir-toast></p>
      <p class="sr-only" role="status" aria-live="polite" data-ir-live></p>

      <div class="empty" data-ir-empty>
        <p class="empty-title">No images yet</p>
        <p class="empty-text">Add images above. You will see the exact size each one will become before you resize.</p>
      </div>
      <ul class="list" aria-label="Images" data-ir-list hidden></ul>
    </section>
  </div>

  <!-- One list item (cloned by the script) -->
  <template data-ir-template>
    <li class="item">
      <div class="thumb" data-thumb aria-hidden="true"></div>
      <div class="body">
        <p class="name" data-name></p>
        <p class="meta" data-meta></p>
        <p class="plan" data-plan></p>
        <p class="state" data-state></p>
        <div class="info" data-info hidden></div>
        <div class="result" data-result hidden>
          <div class="preview" data-preview aria-hidden="true"></div>
          <dl class="facts">
            <div class="wide"><dt>Size</dt><dd data-r-dims></dd></div>
            <div><dt>Original</dt><dd data-r-orig></dd></div>
            <div><dt>Resized</dt><dd data-r-new></dd></div>
            <div><dt>Change</dt><dd class="change" data-r-change></dd></div>
            <div><dt>Format</dt><dd data-r-format></dd></div>
          </dl>
        </div>
        <p class="warn" data-warn hidden></p>
      </div>
      <div class="item-actions">
        <button class="btn btn-primary btn-sm" type="button" data-run>Resize</button>
        <button class="btn btn-secondary btn-sm" type="button" data-download hidden>Download</button>
        <button class="btn btn-secondary btn-sm" type="button" data-compare aria-expanded="false" hidden>Compare</button>
        <button class="btn btn-secondary btn-sm remove" type="button" data-remove>Remove</button>
      </div>
      <div class="cmp" data-cmp hidden></div>
    </li>
  </template>
</div>

<script>
  import '../../scripts/imageResizer.js';
</script>

<style>
  .ir { display: grid; gap: 1.25rem; }
  .card { padding: clamp(1rem, 2.5vw, 1.5rem); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); min-width: 0; }
  .card-title { font-size: 1.1875rem; }
  fieldset, legend { margin: 0; padding: 0; border: 0; }
  dl, dd, dt { margin: 0; }

  .drop { border: 2px dashed var(--line-strong); background: var(--surface-inset); text-align: center; transition: border-color var(--fast) var(--ease), background var(--fast) var(--ease); }
  .drop[data-dragging='true'] { border-color: var(--accent); background: var(--accent-tint); border-style: solid; }
  .drop-body { display: grid; justify-items: center; gap: 0.75rem; padding-block: 0.75rem; }
  .drop-title { font-size: 1.375rem; }
  .drop-lead { max-width: 34rem; color: var(--ink-2); }
  .drop-hint { max-width: 40rem; font-size: 0.8125rem; color: var(--muted); }
  .notes { font-size: 0.875rem; color: var(--ink-2); padding: 0.6rem 0.9rem; border: 1px solid color-mix(in srgb, var(--clay) 40%, var(--line)); border-left-width: 3px; border-radius: var(--radius); background: var(--clay-tint); display: grid; gap: 0.2rem; }

  .layout { display: grid; gap: 1.25rem; align-items: start; }
  @media (min-width: 960px) {
    .layout { grid-template-columns: 22rem minmax(0, 1fr); gap: 1.5rem; }
    .settings { position: sticky; top: calc(var(--header-h) + 1rem); }
  }

  .settings { display: grid; gap: 1.25rem; }
  .group { display: grid; gap: 0.6rem; min-width: 0; }
  legend, .group > label, .field > label { font-weight: 650; font-size: 0.9375rem; color: var(--ink); }
  .help { font-size: 0.8125rem; line-height: 1.5; color: var(--muted); }
  .help:empty { display: none; }
  .help.fine { padding-top: 0.5rem; border-top: 1px solid var(--line); }
  #ir-lock-note[data-kind='warn'] { color: var(--clay-text); font-weight: 600; }
  .msg { font-size: 0.8125rem; font-weight: 600; color: var(--clay-text); }

  .segmented { display: inline-flex; flex-wrap: wrap; padding: 3px; gap: 2px; background: var(--surface-sunken); border: 1px solid var(--line); border-radius: var(--radius); max-width: 100%; }
  .segmented.three { display: grid; grid-template-columns: repeat(3, 1fr); }
  .segmented.three .seg span { padding-inline: 0.25rem; white-space: normal; font-size: 0.8125rem; line-height: 1.25; display: grid; place-items: center; min-height: 2.25rem; }
  .seg { position: relative; cursor: pointer; flex: 1 1 auto; }
  .seg input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .seg span { display: block; padding: 0.45rem 0.8rem; border-radius: calc(var(--radius) - 3px); font-size: 0.875rem; font-weight: 550; color: var(--ink-2); text-align: center; white-space: nowrap; transition: background var(--fast) var(--ease), color var(--fast) var(--ease); }
  .seg:hover span { color: var(--ink); }
  .seg input:checked + span { background: var(--surface); color: var(--ink); box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line-strong); }
  .seg input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .seg input:disabled + span { opacity: 0.45; text-decoration: line-through; cursor: not-allowed; }

  .dims { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 0.5rem; align-items: start; }
  .times { padding-top: 2.45rem; color: var(--muted); font-size: 1.1rem; }
  .field { display: grid; gap: 0.4rem; min-width: 0; }
  .input { width: 100%; min-width: 0; padding: 0.65rem 0.8rem; background: var(--surface-inset); border: 1px solid var(--line-strong); border-radius: var(--radius); font-size: 1rem; color: var(--ink); font-variant-numeric: tabular-nums; transition: border-color var(--fast) var(--ease), box-shadow var(--fast) var(--ease); }
  .input::placeholder { color: var(--placeholder); }
  .input:focus, .input:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-tint); }
  .input[aria-invalid='true'] { border-color: var(--clay); }
  .input.narrow { max-width: 9rem; }
  .pct-row { display: flex; align-items: center; gap: 0.5rem; }
  .unit { color: var(--muted); font-weight: 650; }
  .check { display: flex; gap: 0.7rem; align-items: flex-start; cursor: pointer; font-weight: 600; font-size: 0.9375rem; }
  .check input { width: 1.15rem; height: 1.15rem; margin: 0.15rem 0 0; accent-color: var(--accent); flex: none; cursor: pointer; }

  .presets { display: grid; gap: 0.4rem; }
  .preset { position: relative; display: block; cursor: pointer; }
  .preset input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .preset-body { display: grid; gap: 0.1rem; padding: 0.55rem 0.8rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface-inset); transition: border-color var(--fast) var(--ease), background var(--fast) var(--ease); }
  .preset-body strong { font-size: 0.9375rem; color: var(--ink); font-variant-numeric: tabular-nums; }
  .preset-body small { font-size: 0.75rem; color: var(--muted); }
  .preset:hover .preset-body { border-color: var(--line-strong); }
  .preset input:checked + .preset-body { border-color: var(--accent); background: var(--accent-tint); box-shadow: inset 3px 0 0 var(--accent); }
  .preset input:focus-visible + .preset-body { outline: 2px solid var(--accent); outline-offset: 2px; }

  .bg-row { display: flex; align-items: center; gap: 0.75rem; }
  .color { width: 3.25rem; height: 2.5rem; padding: 2px; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--surface); cursor: pointer; }
  .color:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .bg-out { font-family: var(--font-mono); font-size: 0.875rem; color: var(--ink-2); }

  .res-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem 1rem; margin-bottom: 0.9rem; }
  .count { font-family: var(--font-sans); font-size: 0.875rem; font-weight: 500; color: var(--muted); margin-left: 0.4rem; }
  .toolbar-actions, .confirm { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .confirm span { font-size: 0.9375rem; font-weight: 600; color: var(--ink); }
  .danger { background: var(--clay-text); }
  .danger:hover { background: var(--clay-text); filter: brightness(0.92); }
  :global(:root[data-theme='dark']) .danger { background: var(--clay); color: var(--accent-ink); }

  .progress { margin-bottom: 0.75rem; }
  .bar { height: 10px; border-radius: 999px; background: var(--surface-sunken); border: 1px solid var(--line); overflow: hidden; }
  .bar-fill { display: block; height: 100%; width: 0; background: var(--accent); border-radius: inherit; transition: width var(--med) var(--ease); }
  .progress-text { margin-top: 0.4rem; font-size: 0.875rem; color: var(--ink-2); overflow-wrap: anywhere; }
  .summary { margin-bottom: 0.5rem; padding: 0.6rem 0.9rem; font-size: 0.9375rem; font-weight: 600; color: var(--ink); background: var(--success-tint); border: 1px solid color-mix(in srgb, var(--success) 30%, var(--line)); border-left-width: 3px; border-radius: var(--radius); }
  .toast { min-height: 1.3em; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; }
  .toast[data-kind='ok'] { color: var(--success); }
  .toast[data-kind='bad'] { color: var(--clay-text); }
  .toast[data-kind='ok']::before { content: '\2713\00a0'; }
  .toast[data-kind='bad']::before { content: '!\00a0'; }
  .empty { padding: 2.5rem 1rem; text-align: center; border: 1px dashed var(--line-strong); border-radius: var(--radius); background: var(--surface-inset); }
  .empty-title { font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; color: var(--ink); }
  .empty-text { margin-top: 0.3rem; font-size: 0.9375rem; color: var(--muted); }
  .list { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  /* Touch targets: at least 44px on phones and touch screens (in this scoped block so it outranks the base rules above). */
  @media (max-width: 639px), (pointer: coarse) {
    .seg span, .segmented.three .seg span { min-height: 44px; display: grid; place-items: center; }
    .check { min-height: 44px; align-items: center; }
    .preset-body { min-height: 44px; align-content: center; }
    .color { height: 44px; }
  }
</style>

<!-- Item styles are global because the items are created from the <template> by the script. -->
<style is:global>
  .ir [hidden] { display: none !important; }
  .ir .item { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr) auto; gap: 0.75rem 1rem; align-items: start; padding: 0.85rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface-inset); }
  .ir .item[data-status='rejected'], .ir .item[data-status='failed'] { border-color: color-mix(in srgb, var(--clay) 50%, var(--line)); background: color-mix(in srgb, var(--clay-tint) 40%, var(--surface-inset)); }
  .ir .thumb, .ir .preview { display: grid; place-items: center; border-radius: var(--radius-sm); border: 1px solid var(--line); overflow: hidden; background: var(--surface-sunken); }
  .ir .thumb { width: 5.5rem; height: 5.5rem; }
  .ir .preview { width: 5.5rem; height: 5.5rem; flex: none; }
  .ir .thumb[data-alpha='true'], .ir .preview[data-alpha='true'] { background-color: #fff; background-image: linear-gradient(45deg, #d9d4c8 25%, transparent 25%, transparent 75%, #d9d4c8 75%), linear-gradient(45deg, #d9d4c8 25%, transparent 25%, transparent 75%, #d9d4c8 75%); background-size: 12px 12px; background-position: 0 0, 6px 6px; }
  .ir .thumb canvas, .ir .preview canvas { display: block; max-width: 100%; max-height: 100%; }
  .ir .body { min-width: 0; display: grid; gap: 0.2rem; }
  .ir .name { font-weight: 650; color: var(--ink); overflow-wrap: anywhere; line-height: 1.35; }
  .ir .meta { font-size: 0.8125rem; color: var(--muted); }
  .ir .plan { font-size: 0.8125rem; font-weight: 600; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .ir .plan[data-kind='warn'] { color: var(--clay-text); }
  .ir .plan[data-kind='error'] { color: var(--clay-text); }
  .ir .plan[data-kind='error']::before { content: '! '; }
  .ir .state { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8125rem; font-weight: 650; color: var(--ink-2); }
  .ir .state-icon { display: inline-grid; place-items: center; width: 1.1rem; height: 1.1rem; border-radius: 50%; font-size: 0.7rem; background: var(--surface-sunken); }
  .ir .state[data-kind='done'] { color: var(--success); }
  .ir .state[data-kind='done'] .state-icon { background: var(--success-tint); }
  .ir .state[data-kind='error'], .ir .state[data-kind='stale'] { color: var(--clay-text); }
  .ir .state[data-kind='error'] .state-icon { background: var(--clay-tint); }
  .ir .info { display: grid; gap: 0.2rem; }
  .ir .item-note { font-size: 0.8125rem; line-height: 1.5; color: var(--ink-2); overflow-wrap: anywhere; }
  .ir .state[data-kind='error'] ~ .info .item-note { color: var(--clay-text); font-weight: 600; }
  .ir .result { display: flex; gap: 0.9rem; align-items: flex-start; margin-top: 0.35rem; padding-top: 0.6rem; border-top: 1px solid var(--line); }
  .ir .facts { flex: 1; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr)); gap: 0.4rem 1rem; }
  .ir .facts .wide { grid-column: 1 / -1; }
  .ir .facts dt { font-size: 0.6875rem; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .ir .facts dd { font-size: 0.9375rem; font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .ir .change[data-dir='smaller'] { color: var(--success); }
  .ir .change[data-dir='larger'] { color: var(--clay-text); }
  .ir .warn { margin-top: 0.2rem; font-size: 0.8125rem; line-height: 1.5; color: var(--clay-text); font-weight: 600; }
  .ir .item-actions { display: flex; flex-direction: column; align-items: stretch; gap: 0.4rem; min-width: 8.5rem; }
  .ir .cmp { grid-column: 1 / -1; }

  .ir .cmp-stage { --pos: 50%; position: relative; max-width: 46rem; margin-inline: auto; border: 1px solid var(--line-strong); border-radius: var(--radius); overflow: hidden; line-height: 0; user-select: none;
