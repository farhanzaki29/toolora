---
import { site } from '../config/site.js';
---

<a class="brand" href="/">
  <span class="mark" aria-hidden="true">{site.name.charAt(0)}</span>
  <span class="name">{site.name}</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    font-style: italic;
    transition: background var(--fast) var(--ease);
  }
  .brand:hover .mark { background: var(--clay); }
</style>
