---
import Brand from './Brand.astro';
import { site } from '../config/site.js';
import { liveTools, toolHref } from '../data/tools.js';

const year = new Date().getFullYear();
const groups = [
  { title: 'Tools', label: 'Tools', links: liveTools.map((t) => ({ label: t.name, href: toolHref(t) })) },
  ...site.footer.map((g) => ({ ...g, label: g.title })),
];
---

<footer class="footer">
  <div class="container top">
    <div class="about">
      <Brand />
      <p>{site.description}</p>
    </div>

    {groups.map((g) => (
      <nav aria-label={g.label}>
        <h2>{g.title}</h2>
        <ul>
          {g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>

  <div class="container bottom">
    <p>© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-alt);
    border-top: 1px solid var(--line-strong);
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }
  .top {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr 1fr;
    padding-bottom: 3rem;
  }
  .about { grid-column: 1 / -1; max-width: 22rem; }
  .about p { margin-top: 1rem; color: var(--muted); font-size: 0.9375rem; }

  h2 {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 650;
    color: var(--clay-text);
    margin-bottom: 1rem;
  }
  ul { display: grid; gap: 0.6rem; }
  li a {
    font-size: 0.9375rem;
    color: var(--ink-2);
    transition: color var(--fast) var(--ease);
  }
  li a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .bottom {
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  @media (min-width: 800px) {
    .top { grid-template-columns: repeat(4, 1fr); }
    .about { grid-column: 1 / -1; max-width: 26rem; }
  }
  @media (min-width: 1000px) {
    .top { grid-template-columns: 1.5fr 1.2fr 0.9fr 0.9fr 1fr; }
    .about { grid-column: auto; }
  }
</style>
